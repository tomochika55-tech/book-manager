// Prisma schema for the reading-management service.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // アプリ実行時に使う接続（Neon のプール付き URL）
  url       = env("DATABASE_URL")
  // マイグレーション実行時に使う直結 URL（Neon の -pooler なし URL）
  directUrl = env("DIRECT_URL")
}

/// アプリの利用者。メール+パスワードでログインする。
/// 将来的に Google などの OAuth を足す場合は passwordHash を任意のままにし、
/// Account モデルを追加すれば拡張できる。
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  createdAt    DateTime @default(now())
  books        Book[]
}

/// 1 冊の本の記録。ステータス・評価・感想・共有設定などを持つ。
model Book {
  id         String    @id @default(cuid())
  // 所有ユーザー。ユーザーごとに本棚を分離する。
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  author     String
  genre      String?
  coverUrl   String?
  pages      Int?
  publisher     String?
  publishedYear Int?
  // want (読みたい/積読) | reading (読書中) | finished (読了)
  status     String    @default("want")
  // 自分でつける 1〜5 の星評価（読了本のみ想定）
  rating     Int?
  review     String?
  // 共有機能: true なら誰でも見られる公開ページを持つ
  isPublic   Boolean   @default(false)
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([genre])
}
