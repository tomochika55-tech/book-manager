// Prisma schema for the reading-management service.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // アプリ実行時に使う接続（Neon のプール付き URL）
  url       = env("DATABASE_URL")
  // マイグレーション実行時に使う直結 URL（Neon の -pooler なし URL）
  directUrl = env("DIRECT_URL")
}

/// アプリの利用者。メール+パスワードでログインする。
/// 将来的に Google などの OAuth を足す場合は passwordHash を任意のままにし、
/// Account モデルを追加すれば拡張できる。
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  createdAt    DateTime @default(now())
  books        Book[]

  following     Follow[]       @relation("Follower")
  followers     Follow[]       @relation("Following")
  likes         Like[]
  notifications Notification[] @relation("NotificationRecipient")
  actedNotifications Notification[] @relation("NotificationActor")
}

/// 1 冊の本の記録。ステータス・評価・感想・共有設定などを持つ。
model Book {
  id         String    @id @default(cuid())
  // 所有ユーザー。ユーザーごとに本棚を分離する。
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  author     String
  genre      String?
  coverUrl   String?
  pages      Int?
  publisher     String?
  publishedYear Int?
  // want (読みたい/積読) | reading (読書中) | finished (読了)
  status     String    @default("want")
  // 自分でつける 1〜5 の星評価（読了本のみ想定）
  rating     Int?
  review     String?
  // 共有機能: true なら誰でも見られる公開ページを持つ
  isPublic   Boolean   @default(false)
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  likes         Like[]
  notifications Notification[]

  @@index([userId])
  @@index([status])
  @@index([genre])
}

/// フォロー関係。followerId が followingId をフォローしている。
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

/// 公開された本の記録への「いいね」。
model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, bookId])
  @@index([bookId])
}

/// ユーザーへの通知（フォローされた・いいねされた）。
model Notification {
  id        String   @id @default(cuid())
  // 通知を受け取るユーザー
  userId    String
  user      User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  // 通知を発生させたユーザー（フォローした人・いいねした人）
  actorId   String
  actor     User     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  // "follow" | "like"
  type      String
  // いいね通知の場合、対象の本
  bookId    String?
  book      Book?    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
