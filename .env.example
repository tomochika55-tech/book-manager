# SQLite database file location (relative to the prisma/ directory).
# Copy this file to `.env` before running the app: cp .env.example .env
DATABASE_URL="file:./dev.db"

# Auth.js の署名用シークレット。次のコマンドで生成できる:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-secret"

# AI おすすめ機能（任意）。どちらか一方を設定するとAI提案に切り替わる。
# 未設定でも従来ロジックで動作する。
# GEMINI_API_KEY=""
# ANTHROPIC_API_KEY=""
