# --- データベース（PostgreSQL / Neon 推奨） ---
# Neon ダッシュボードの接続文字列を貼り付ける。
# DATABASE_URL: プール付き（ホスト名に -pooler が入っている方）
# DIRECT_URL  : 直結（-pooler が入っていない方。マイグレーション用）
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# --- 認証（必須） ---
# セッション署名用のランダム文字列。次で生成:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-secret"

# --- AI おすすめ（任意） ---
# どちらか設定すると AI 提案に切り替わる。未設定でもルールベースで動作。
# GEMINI_API_KEY=""
# ANTHROPIC_API_KEY=""
